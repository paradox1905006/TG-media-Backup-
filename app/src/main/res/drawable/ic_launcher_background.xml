<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background layer — solid black with a very subtle
    dark-blue radial glow that matches the neon foreground style.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base black fill -->
    <path
        android:fillColor="#000000"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

    <!-- Subtle dark-blue centre glow so the icon isn't flat on dark launchers -->
    <path
        android:fillColor="#0A0E1A"
        android:pathData="
            M54,54
            m-45,0
            a45,45 0 1,0 90,0
            a45,45 0 1,0 -90,0" />

</vector>
